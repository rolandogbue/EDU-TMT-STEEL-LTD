# Environment variables
#
# Copy this file to `.env` and fill in the values for your own backend project.
#
#   cp .env.example .env
#
# Variables prefixed with VITE_ are inlined into the browser bundle at build
# time. They are publishable by design — never put a private key behind a
# VITE_ prefix.

# --- Client (browser-visible, safe to publish) ---------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# --- Server (used during SSR and in server functions) -------------------
# Same values as above; read via process.env on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_PROJECT_ID=your-project-id

# --- Server, PRIVATE (never commit a real value, never prefix with VITE_) ---
# Optional for basic local development. Required for the initial-admin
# bootstrap endpoint and Team & roles management. Configure it only on the
# server or local `.env`; never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
