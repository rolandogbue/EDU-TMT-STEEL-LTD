# Environment variables
#
# Copy this file to `.env` and fill in the values for your own backend project.
#
#   cp .env.example .env
#
# Variables prefixed with VITE_ are inlined into the browser bundle at build
# time. They are publishable by design — never put a private key behind a
# VITE_ prefix.

# --- Client (browser-visible, safe to publish) ---------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server (used during SSR and in server functions) -------------------
# Same values as above; read via process.env on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Server, PRIVATE (never commit a real value, never prefix with VITE_) ---
# Optional locally. Required only for the default-admin bootstrap endpoint and
# the Team & roles management screen. Prefer the current secret-key name;
# SUPABASE_SERVICE_ROLE_KEY remains supported for existing deployments.
# Leaving both empty disables those two
# features with a clear message instead of a crash. Configure this only in a
# trusted server environment when those features are needed.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
